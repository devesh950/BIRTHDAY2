// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// ENUMS
// =====================

enum UserRole {
  USER
  ADMIN
}

enum ExperienceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OccasionType {
  BIRTHDAY
  ANNIVERSARY
  LOVE
  PROPOSAL
  FRIENDSHIP
  WEDDING
  GRADUATION
  FAMILY
  FAREWELL
  APOLOGY
  CUSTOM
}

enum RecipientType {
  GIRLFRIEND
  BOYFRIEND
  WIFE
  HUSBAND
  BEST_FRIEND
  MOTHER
  FATHER
  BROTHER
  SISTER
  OTHER
}

enum MoodType {
  ROMANTIC
  CUTE
  ELEGANT
  PLAYFUL
  EMOTIONAL
  CINEMATIC
  MINIMAL
  VINTAGE
  FUN
}

enum AnimationLevel {
  MINIMAL
  BALANCED
  MAGICAL
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PlanType {
  FREE
  PREMIUM
  PREMIUM_PLUS
  BUNDLE
}

// =====================
// MODELS
// =====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts     Account[]
  sessions     Session[]
  experiences  Experience[]
  orders       Order[]
  analyticsEvents AnalyticsEvent[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Experience {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  occasion    OccasionType
  recipient   RecipientType
  status      ExperienceStatus @default(DRAFT)
  plan        PlanType         @default(FREE)

  // User input
  storyText      String?   @db.Text
  recipientName  String?
  senderName     String?
  specialDate    DateTime?

  // AI Generated Experience JSON
  experienceJson Json?

  // Theme
  mood           MoodType?
  animationLevel AnimationLevel @default(BALANCED)
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  fontStyle      String?
  backgroundStyle String?

  // Meta
  passwordProtected Boolean @default(false)
  password          String?
  customMessage     String? @db.Text

  // Stats
  viewCount     Int @default(0)
  shareCount    Int @default(0)
  qrScanCount   Int @default(0)

  // SEO
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?

  // Music
  musicUrl      String?
  musicTitle    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  publishedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sections   ExperienceSection[]
  media      Media[]
  orders     Order[]
  analyticsEvents AnalyticsEvent[]

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([occasion])
}

model ExperienceSection {
  id           String @id @default(cuid())
  experienceId String
  type         String
  content      Json
  order        Int
  isVisible    Boolean @default(true)
  settings     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Media {
  id           String    @id @default(cuid())
  experienceId String
  type         MediaType @default(IMAGE)
  url          String
  publicId     String    // Cloudinary public ID
  thumbnailUrl String?
  altText      String?
  order        Int       @default(0)
  sizeBytes    Int?
  width        Int?
  height       Int?
  mimeType     String?

  createdAt DateTime @default(now())

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Template {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  occasion    OccasionType
  mood        MoodType
  plan        PlanType     @default(FREE)
  isPublished Boolean      @default(false)
  isFeatured  Boolean      @default(false)
  previewUrl  String?
  thumbnailUrl String?
  config      Json         // Template configuration JSON
  usageCount  Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occasion])
  @@index([isPublished])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  userId       String
  experienceId String?
  plan         PlanType
  status       OrderStatus @default(PENDING)
  amountPaise  Int         // Amount in paise (1 INR = 100 paise)
  currency     String      @default("INR")

  // Razorpay
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  // Refund
  refundId      String?
  refundedAt    DateTime?
  refundAmountPaise Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([experienceId])
  @@index([status])
  @@index([razorpayOrderId])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  event        String
  userId       String?
  experienceId String?
  sessionId    String?
  properties   Json?
  userAgent    String?
  ip           String?
  country      String?
  city         String?
  referrer     String?
  createdAt    DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  experience Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([userId])
  @@index([experienceId])
  @@index([createdAt])
}

// Future-ready models (scaffolded, not yet implemented)
model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  discountPct  Int
  maxUses      Int?
  usedCount    Int      @default(0)
  expiresAt    DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([code])
}
